# Copy to .env.local and fill in. Never commit real values.
#
# NEXT_PUBLIC_* variables are built into the browser code and are PUBLIC: only
# put values there that are safe for anyone to see (project IDs, public URLs,
# the Supabase anon key). Every other variable is server-only and secret.

# ─────────────────────────────────────────────────────────────────────────────
# Sanity CMS — fill in once you create the Sanity project at sanity.io
# ─────────────────────────────────────────────────────────────────────────────

# From Sanity dashboard → Project settings → "Project ID"
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Usually "production"
NEXT_PUBLIC_SANITY_DATASET=production

# Content Lake API version — pin a date, don't track latest
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01

# Studio URL (used only by Presentation preview later; safe to leave blank now)
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3000/studio

# Secret for /api/revalidate. Any long random string (32+ characters).
# Put the same value in the Sanity webhook's "Secret" field: Sanity then signs
# every call and the site verifies the signature. Server only.
SANITY_REVALIDATE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Contact form: saves to Supabase and emails the team through Resend
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

RESEND_API_KEY=
# Where messages are delivered
CONTACT_TO_EMAIL=info@ciomogulindia.com
# Sender shown on the email. Must be on a domain verified in Resend.
# Until then leave blank to use Resend's test sender.
CONTACT_FROM_EMAIL=

# Public address of the site, used for the sitemap and share links
NEXT_PUBLIC_SITE_URL=https://www.ciomogulindia.com

# ─────────────────────────────────────────────────────────────────────────────
# Newsletter
# ─────────────────────────────────────────────────────────────────────────────
# Optional but needed for the unsubscribe link and for letting people re-subscribe.
# This is a SECRET key (Supabase > Project Settings > API Keys > secret / service_role).
# Server only. Never put it in a NEXT_PUBLIC_ variable or share it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Signs unsubscribe links. Any long random string. If empty, the Resend key is used.
NEWSLETTER_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Search engines
# ─────────────────────────────────────────────────────────────────────────────
# From Google Search Console: add the site, choose "HTML tag", and paste only the
# content="..." value here. Proves you own the site so you can submit the sitemap.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Only used by the seed scripts on your own computer (npm run seed). Sanity > API >
# Tokens > role: Editor. Never add it to the hosting provider; the live site does
# not need it. Keep private.
SANITY_API_WRITE_TOKEN=
